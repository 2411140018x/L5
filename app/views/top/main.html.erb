<h1>つぶやきアプリ</h1>

<% flash.each do |type, msg| %>
  <p style="color: red;"><%= msg %></p>
<% end %>

<% if current_user %>
  <p>
    <%= session[:login_uid] %> でログイン中
    <%= link_to "プロフィール", current_user.profile ? edit_profile_path : new_profile_path %>
    <%= link_to "ログアウト", top_logout_path %>
  </p>
  <%= form_with model: @tweet do |f| %>
    <%= f.text_field :message %>
    <%= f.submit "ツイート" %>
  <% end %>
<% else %>
  <%= render "login_form" %>
<% end %>

<ul>
  <% @tweets.each do |tweet| %>
    <li>
        <%= tweet.user.uid %>：<%= tweet.message %>
        （いいね <%= tweet.likes.count %>）
        <% if session[:login_uid] %>
            <%= link_to "いいね", likes_path(tweet_id: tweet.id), data: { turbo_method: :post } %>
            <%= link_to "いいね削除", like_path(tweet), data: { turbo_method: :delete } %>
            <%= link_to "削除", tweet_path(tweet), data: { turbo_method: :delete } %>
        <% end %>
    </li>
  <% end %>
</ul>

